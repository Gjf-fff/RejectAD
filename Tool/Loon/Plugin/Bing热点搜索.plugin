#!name = Bing热点搜索
#!icon = https://www.bing.com/favicon.ico
#!desc = 直接填写每天执行时间HH:mm，设置搜索次数与间隔；非 Rewards 签到
#!author = Gjf-fff
#!homepage = https://github.com/Gjf-fff/RejectAD
#!tag = Bing,热点,定时任务
#!loon_version = 3.5.1(983)
#!date = 2026-11-04

[Argument]
runTime = input,"09:00",type=string,tag=每天执行时间,desc=直接填写24小时制时间，例如09:00或20:30；无需Cron表达式
searchCount = input,5,type=number,tag=搜索次数,desc=每次执行搜索1到30次
searchInterval = input,15,type=number,tag=搜索间隔(秒),desc=每次搜索之间等待1到120秒
showNotify = switch,true,type=boolean,tag=运行完成通知,desc=是否显示执行结果通知
taskEnabled = switch,true,type=boolean,tag=启用定时任务,desc=关闭后不自动运行

[Script]
cron "* * * * *" then script("https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/bing_hot_topics.js", {${runTime}, ${searchCount}, ${searchInterval}, ${showNotify}, ${taskEnabled}}) with enable=${taskEnabled}, timeout=3900, tag="Bing热点搜索"
