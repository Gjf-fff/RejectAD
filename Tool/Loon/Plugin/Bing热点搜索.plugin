#!name = Bing热点搜索
#!desc = 自定义运行时间、搜索次数与间隔；普通 Bing 热点搜索，非 Rewards 签到
#!author = Gjf-fff
#!homepage = https://github.com/Gjf-fff/RejectAD
#!tag = Bing,热点,定时任务
#!version = 1.1.0

[Script]
# 修改 cron 的 0 9 即每天 09:00；例如 30 20 即每天 20:30。
# argument 中 count=搜索次数(1-30)，interval=每次搜索间隔秒数(1-120)。
# 如果改远程订阅文件，请在 GitHub 更新；仅在 Loon 中改本地副本则不会影响仓库。
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/bing_hot_topics.js,argument=count=5&interval=15,tag=Bing热点搜索,timeout=600
