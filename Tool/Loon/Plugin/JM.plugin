#!name = 我不是涩神
#!desc = 合并 JM、小说网页去广告，MissAV 已知广告防弹窗及 51CG 播放前贴片处理。需要复写、脚本和 MitM，重新打开原网页后生效；部分处理尚需手机验证。
#!author = Gjf-fff
#!icon = https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/Icon/JM-avatar.png
#!homepage = https://github.com/Gjf-fff/RejectAD/blob/main/Tool/Loon/README_JM.md
#!tag = 去广告,网页

[Rule]
# 仅列出本次抓包确认的广告加载主机。
DOMAIN,a.chnsrv.com,REJECT
DOMAIN,s.chnsrv.com,REJECT
DOMAIN,campfirecroutondecorator.com,REJECT
DOMAIN,t.snaptrckr.fun,REJECT
DOMAIN,cdn.storagexhd.com,REJECT
DOMAIN,static.javhdhello.com,REJECT
DOMAIN,cdn.bncloudfl.com,REJECT
DOMAIN,cdn.pncloudfl.com,REJECT
DOMAIN,z6v2p9a8.bkcdn.net,REJECT
DOMAIN,sc.ec424.com,REJECT
DOMAIN,ads.exoclick.com,REJECT

[Rewrite]
# HAR 208：仅处理确认的广告文件；正常封面、勋章、视频及其他 jquery 文件不匹配。
^https?:\/\/(?:www\.)?18comic\.vip\/templates\/frontend\/airav\/js\/jquery\.7_2dc\.js(?:\?|$) reject-200
^https?:\/\/a\.magsrv\.com\/ad-provider\.js(?:\?|$) reject-200
^https?:\/\/www\.dell\.com\/community\/assets\/community\/687062f5-603c-4f5f-ab9d-31aa7cacb376\/manhua-9fac3c05-eef9-44ee-b0da-9768c33160a8-512816432\.gif(?:\?|$) reject-img

[Script]
http-response ^https?:\/\/(?:www\.)?18comic\.vip\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/jm_web_ad_patch.js?v=1.1.1,requires-body=true,timeout=10,tag=JM网页广告补丁,enable=true

http-response ^https?:\/\/(?:www\.)?missav\.ai\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/video_popup_patch.js,requires-body=true,timeout=10,tag=视频播放广告弹窗补丁,enable=true

http-response ^https?:\/\/(?:www\.)?51cg1\.com\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/cg_web_ad_patch.js?v=1.0.0,requires-body=true,timeout=10,tag=51CG网页广告补丁,enable=true

http-request ^https?:\/\/g\.yfrwa\.cn\/(?:2023\/07\/(?:20220343877|20220354862)|2021\/12\/31160939776)\.txt(?:\?|$) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.2.0,timeout=10,tag=小说广告素材替换,enable=true

http-response ^https?:\/\/[a-z0-9.-]*banzhu[a-z0-9.-]*(?::\d+)?\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.2.0,requires-body=true,timeout=10,tag=小说网页广告补丁,enable=true

# 仅当 Referer/Origin 为小说站时，由脚本取消已确认的推广导航。
http-request ^https?:\/\/(?:www\.(?:pm1256tiger|hm1614t|hm1619t)\.vip:9527\/?(?:\?|$)|2\.s5825hu\.cc:8888\/?(?:\?|$)|1214gc\.x2062ys\.com:8005\/(?:cc|d)\/3876(?:\?|$)|www\.c4jsrnirobpg\.vip:20110\/news\/decide-obscure\.html(?:\?|$)) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.2.0,timeout=10,tag=小说推广导航拦截,enable=true

[Mitm]
hostname = 18comic.vip,www.18comic.vip,missav.ai,www.missav.ai,51cg1.com,www.51cg1.com,*banzhu*,g.yfrwa.cn,www.dell.com,a.magsrv.com,www.pm1256tiger.vip,www.hm1614t.vip,www.c4jsrnirobpg.vip,www.hm1619t.vip,2.s5825hu.cc,1214gc.x2062ys.com
