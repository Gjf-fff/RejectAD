#!name = 我不是涩神
#!desc = 去除一些学习资料的广告
#!author = Gjf-fff
#!icon = https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/Icon/JM-avatar.png
#!homepage = https://github.com/Gjf-fff/RejectAD/blob/main/Tool/Loon/README_JM.md
#!tag = 去广告,网页

[Rule]
# 仅列出本次抓包确认的广告加载主机。
DOMAIN,a.chnsrv.com,REJECT
DOMAIN,s.chnsrv.com,REJECT
DOMAIN,campfirecroutondecorator.com,REJECT
DOMAIN,t.snaptrckr.fun,REJECT
DOMAIN,cdn.storagexhd.com,REJECT
DOMAIN,static.javhdhello.com,REJECT
DOMAIN,cdn.bncloudfl.com,REJECT
DOMAIN,cdn.pncloudfl.com,REJECT
DOMAIN,z6v2p9a8.bkcdn.net,REJECT
DOMAIN,sc.ec424.com,REJECT
DOMAIN,ads.exoclick.com,REJECT

# 知乎广告模块（HAR 246 合并）
# 仅限制知乎核心 API 的 QUIC，促使支持回退的连接改走 TCP；HAR 233 未证明 QUIC 是根因。
# 协议/逻辑规则需要 Loon 3.1.7+；本地放行规则可能优先于插件规则。
AND,((DOMAIN,api.zhihu.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# HAR 208：仅处理确认的广告文件；正常封面、勋章、视频及其他 jquery 文件不匹配。
^https?:\/\/(?:www\.)?(?:18comic\.vip|jmcomic-zzz\.one)\/templates\/frontend\/airav\/js\/jquery\.7_2dc\.js(?:\?|$) reject-200
^https?:\/\/a\.magsrv\.com\/ad-provider\.js(?:\?|$) reject-200
^https?:\/\/www\.dell\.com\/community\/assets\/community\/687062f5-603c-4f5f-ab9d-31aa7cacb376\/manhua-9fac3c05-eef9-44ee-b0da-9768c33160a8-512816432\.gif(?:\?|$) reject-img

# HAR 211 已确认：js4 为透明点击层/强制导航广告入口，in-static 仅创建隐藏广告 iframe。
^https?:\/\/m\.diyibanzhu\.me\/js\/js4\.js(?:\?|$) reject-200
^https?:\/\/www\.plpyvxfgxbz6nuhh\.app:20110\/js\/in-static\.js(?:\?|$) reject-200

# HAR 215：新 JM 域名 CDN 的两张已确认第三方推广图；漫画和站点导航保留。
^https?:\/\/cdn-msp2\.jmcomic-zzz\.one\/static\/resources\/images\/(?:300x-250\.gif|300x250GIF\((?:%E5%B7%A6%EF%BC%89|左）)\.gif)(?:\?|$) reject-img

# HAR 227：反广告检测脚本及确认的遮挡 GIF；不匹配漫画图片或阅读/解图脚本。
^https?:\/\/(?:www\.)?(?:18comic\.vip|jmcomic-zzz\.one)\/templates\/frontend\/airav\/js\/adblock-photo\.js(?:\?|$) reject-200
^https?:\/\/cdn-msp3\.18comic\.vip\/media\/adblock\/20250107_jm_500500_tw\.gif(?:\?|$) reject-img

# 知乎广告模块（HAR 246 合并）
# HAR 243 确认的广告视频目录；保留普通 vzuu 视频路径。
^https?:\/\/vdn\d+\.vzuu\.com\/(?:[^/?#]+\/)?ad_bidding(?:_ob)?\/ reject
# HAR 246：回答/文章底部商业广告接口。
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:answer|article)\/\d+\/bottom-v2\/?(?:\?|$) reject-dict
# 沿用独立知乎插件中 HAR 243 的品牌广告资源/图片规则。
^https?:\/\/zhstatic\.zhihu\.com\/brand-ad\/image\/ reject
^https?:\/\/qh-material\.taobao\.com\/auto\/aigc\/pic\/AI_FLOW_PIC_[^/?]+\.(?:jpg|jpeg|png|webp)(?:\?|$) reject-img
# 沿用 HAR 243 的曝光/竞价规则；拦截通知本身不等于移除广告卡片。
^https?:\/\/adx-track\.domob\.cn\/imp\/?(?:\?|$) reject-200
^https?:\/\/wcp\.taobao\.com\/adstrack\/track\.json(?:\?|$) reject-200
^https?:\/\/lftxali\.fancyapi\.com\/win\/?(?:\?|$) reject-200
^https?:\/\/rtb\.julang\.taobao\.com\/dsp\/surge\/winNotice\/ADX_YIZHUN\/?(?:\?|$) reject-200

# HAR 246：精确匹配开屏、角标及知乎广告曝光接口。
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:launch_v2|banners_v3\/app_float_corner)\/?(?:\?|$) reject-dict
^https?:\/\/sugar\.zhihu\.com\/(?:ad-track\/(?:zplus_log|dream_third)|plutus_adreaper(?:\/(?:page_monitor_log|ad_adx_log))?)\/?(?:\?|$) reject-200

[Script]
# JM 1.1.5：只让网页进入脚本；Cloudflare 验证、AJAX、模板/静态目录及 JS/CSS/图片/字体等静态文件不再整包缓冲。
http-response ^https?:\/\/(?:www\.)?(?:18comic\.vip|jmcomic-zzz\.one)\/(?!(?:cdn-cgi|templates|static|ajax)(?:\/|\?|$))(?![^?#]*\.(?:js|mjs|css|map|json|png|jpe?g|gif|webp|avif|svg|ico|bmp|woff2?|ttf|otf|eot|mp4|webm|m3u8|ts|mp3|zip)(?:[?#]|$)) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/jm_web_ad_patch.js?v=1.1.5,requires-body=true,timeout=10,tag=JM网页广告补丁,enable=true

http-response ^https?:\/\/(?:www\.)?missav\.ai\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/video_popup_patch.js,requires-body=true,timeout=10,tag=视频播放广告弹窗补丁,enable=true

http-response ^https?:\/\/(?:www\.)?51cg1\.com\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/cg_web_ad_patch.js?v=1.0.0,requires-body=true,timeout=10,tag=51CG网页广告补丁,enable=true

http-request ^https?:\/\/g\.yfrwa\.cn\/(?:2023\/07\/(?:20220343877|20220354862)|2021\/12\/31160939776|2023\/09\/24164250640)\.txt(?:\?|$) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.3.0,timeout=10,tag=小说广告素材替换,enable=true

http-response ^https?:\/\/[a-z0-9.-]*banzhu[a-z0-9.-]*(?::\d+)?\/ script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.3.0,requires-body=true,timeout=10,tag=小说网页广告补丁,enable=true

# 仅当 Referer/Origin 为小说站时，由脚本取消已确认的推广导航。
http-request ^https?:\/\/(?:www\.(?:pm1256tiger|hm1614t|hm1619t)\.vip:9527\/?(?:\?|$)|2\.s5825hu\.cc:8888\/?(?:\?|$)|1214gc\.x2062ys\.com:8005\/(?:cc|d)\/3876(?:\?|$)|www\.c4jsrnirobpg\.vip:20110\/news\/decide-obscure\.html(?:\?|$)) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/novel_web_ad_patch.js?v=1.3.0,timeout=10,tag=小说推广导航拦截,enable=true

# 知乎广告模块（HAR 246 合并）
http-response ^https?:\/\/api\.zhihu\.com\/next-render\/?(?:\?|$) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/zhihu_ad_patch.js?v=1.0.2,requires-body=true,timeout=10,tag=知乎回答间广告补丁,enable=true
http-response ^https?:\/\/lens\.zhihu\.com\/api\/v4\/videos\/\d+\/?(?:\?|$) script-path=https://raw.githubusercontent.com/Gjf-fff/RejectAD/main/Tool/Loon/JS/zhihu_ad_patch.js?v=1.0.2,requires-body=true,timeout=10,tag=知乎广告视频播放源补丁,enable=true

[Mitm]
hostname = cdn-msp3.18comic.vip,18comic.vip,www.18comic.vip,jmcomic-zzz.one,www.jmcomic-zzz.one,cdn-msp2.jmcomic-zzz.one,missav.ai,www.missav.ai,51cg1.com,www.51cg1.com,*banzhu*,g.yfrwa.cn,www.dell.com,a.magsrv.com,www.pm1256tiger.vip,www.hm1614t.vip,www.c4jsrnirobpg.vip,www.hm1619t.vip,2.s5825hu.cc,1214gc.x2062ys.com,www.plpyvxfgxbz6nuhh.app,lens.zhihu.com,*.vzuu.com,sugar.zhihu.com,api.zhihu.com,zhstatic.zhihu.com,qh-material.taobao.com,adx-track.domob.cn,wcp.taobao.com,lftxali.fancyapi.com,rtb.julang.taobao.com
