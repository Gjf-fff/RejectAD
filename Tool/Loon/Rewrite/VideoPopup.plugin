#!name = 视频点击广告拦截
#!desc = 根据抓包拦截视频点击后的广告跳转、落地页及配套资源。纯域名规则，无需 MitM；浏览器仍可能打开空白或错误标签页。
#!author = Gjf-fff
#!homepage = https://github.com/Gjf-fff/RejectAD
#!tag = 去广告

# 根据已确认的广告跳转链路配置；本插件不修改网页点击事件。
# 已确认链路：diffusedpassionquaking.com -> 266l.ladyoffices.com。
# 广告落地页加载下列素材、下载配置和渠道上报域名。
# surrit.com 提供 m3u8 和以 .jpeg 命名的视频分片，不能按图片后缀屏蔽。
#
# 使用：启用本插件，在 Loon 分流规则模式下重新加载原视频页面。
# 不需要 HTTPS 解密或安装证书。
# 本插件阻断已捕获的广告请求，不能删除原网页中未捕获的点击弹窗代码。
# 如仍弹出空白页，需要从刷新原网页开始重新抓包，包含 HTML/JS 响应正文。
# 仅匹配本次已识别的域名；网站更换广告域名后需要更新。
# 规则按域名全局生效。

[Rule]
# 广告入口、中转、跟踪请求
DOMAIN-SUFFIX,diffusedpassionquaking.com,REJECT
# 广告落地页及同域脚本
DOMAIN-SUFFIX,ladyoffices.com,REJECT
# 落地页素材
DOMAIN,phoddto36box.tc87.top,REJECT
# 广告下载配置
DOMAIN,appdw.tjucp.top,REJECT
# 广告渠道上报
DOMAIN,httpserver.ssg01.com,REJECT
